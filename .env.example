MONGODB_URI=mongodb://localhost:27017/knoukno
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Sandbox checkout is available only in local development.
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_MEMBER_PLAN_ID=P-REPLACE
PAYPAL_SANDBOX_MEMBER_BONUS_PLAN_ID=P-REPLACE
PAYPAL_SANDBOX_PRO_PLAN_ID=P-REPLACE
PAYPAL_SANDBOX_PRO_BONUS_PLAN_ID=P-REPLACE
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=noreply@knoukno.co
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only live PayPal settings. These do not enable checkout by themselves.
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_MEMBER_PLAN_ID=
PAYPAL_LIVE_PRO_PLAN_ID=
PAYPAL_LIVE_WEBHOOK_ID=

# UUID of the existing account allowed to view /site-admin.
ADMIN_USER_ID=

MONGODB_URI=mongodb://localhost:27017/knoukno
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Sandbox checkout is available only in local development.
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_MEMBER_PLAN_ID=P-REPLACE
PAYPAL_SANDBOX_MEMBER_BONUS_PLAN_ID=P-REPLACE
PAYPAL_SANDBOX_PRO_PLAN_ID=P-REPLACE
PAYPAL_SANDBOX_PRO_BONUS_PLAN_ID=P-REPLACE
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=noreply@knoukno.co
NEXT_PUBLIC_APP_URL=http://localhost:3000
